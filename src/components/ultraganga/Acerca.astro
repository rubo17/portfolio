---
import ButtonProjectRedirect from "@components/shared/ButtonProjectRedirect.astro";
import CodeIcon from "@components/icons/CodeIcon.astro";
import Carousel from "@components/shared/Carousel";
const projectImages = [
    {
        src: "/img/ultraganga/home.png",
        alt: "Página de inicio de UltraGanga",
        description: "Inicio con la ganga destacada y su Deal Score",
    },
    {
        src: "/img/ultraganga/ofertas.png",
        alt: "Listado de ofertas",
        description: "Ofertas del día ordenadas por Deal Score",
    },
    {
        src: "/img/ultraganga/producto.png",
        alt: "Ficha de producto con mejor precio",
        description: "Ficha de producto con mejor precio y análisis del descuento",
    },
    {
        src: "/img/ultraganga/categoria.png",
        alt: "Categoría de wearables",
        description: "Navegación por categorías",
    },
    {
        src: "/img/ultraganga/black-friday.png",
        alt: "Landing de Black Friday",
        description: "Campaña de Black Friday 2026",
    },
    {
        src: "/img/ultraganga/guias.png",
        alt: "Guías de compra",
        description: "Guías de compra para elegir bien",
    },
    {
        src: "/img/ultraganga/como-funciona.png",
        alt: "Cómo funciona el Deal Score",
        description: "Explicación de cómo se calcula el Deal Score",
    },
];
---

<section id="acerca" class="mt-10">
    <div class="flex flex-col gap-6 justify-center items-center mb-10">
        <h1 class="text-4xl font-bold text-accent">UltraGanga</h1>
        <p class="text-lg text-center max-w-3xl text-gray-300">
            Web de ofertas de tecnología y hogar que te dice si un descuento es real o
            solo lo parece. En Black Friday todo parece una ganga, pero el precio «antes»
            lo pone la tienda. UltraGanga compara el precio de hoy con su historial y con
            otras tiendas de España, y le pone a cada oferta un número: su Deal Score.
        </p>
        <div class="flex gap-3 flex-wrap justify-center">
            <span class="bg-accent/10 text-accent border border-accent/30 px-4 py-1.5 rounded-full text-sm font-semibold">Deal Score</span>
            <span class="bg-accent/10 text-accent border border-accent/30 px-4 py-1.5 rounded-full text-sm font-semibold">Historial de precios</span>
            <span class="bg-accent/10 text-accent border border-accent/30 px-4 py-1.5 rounded-full text-sm font-semibold">Afiliación</span>
            <span class="bg-yellow-400/10 text-yellow-300 border border-yellow-400/30 px-4 py-1.5 rounded-full text-sm font-semibold">En construcción</span>
        </div>
        <div class="flex flex-col md:flex-row gap-6">
            <ButtonProjectRedirect
                icon={CodeIcon}
                text="Ver Proyecto"
                url="https://ultraganga.com"
                external={true}
            />
        </div>
    </div>

    <div class="mt-10">
        <Carousel client:load images={projectImages} fit="contain" />
    </div>

    <div class="mt-10 bg-secondary rounded-lg p-8">
        <h3 class="text-xl font-bold text-accent mb-4 text-center">El Catálogo en Cifras</h3>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
            <div>
                <p class="text-4xl font-bold text-white">717</p>
                <p class="text-gray-400 text-sm mt-1">Productos</p>
            </div>
            <div>
                <p class="text-4xl font-bold text-white">731</p>
                <p class="text-gray-400 text-sm mt-1">Ofertas activas</p>
            </div>
            <div>
                <p class="text-4xl font-bold text-white">10</p>
                <p class="text-gray-400 text-sm mt-1">Tiendas</p>
            </div>
            <div>
                <p class="text-4xl font-bold text-white">83</p>
                <p class="text-gray-400 text-sm mt-1">Clics a tiendas · 7 días</p>
            </div>
        </div>
        <p class="text-gray-500 text-xs text-center mt-6">Datos del panel de administración a 24 de octubre de 2026</p>
    </div>

    <div class="mt-10 bg-secondary rounded-lg p-8">
        <h3 class="text-xl font-bold text-accent mb-4 text-center">Funcionalidades Principales</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="flex items-start gap-4">
                <span class="text-accent text-2xl">📊</span>
                <div>
                    <h4 class="font-semibold text-white mb-1">Deal Score</h4>
                    <p class="text-gray-400 text-sm">Puntúa cada oferta de 0 a 100 comparándola con su historial, nunca con el precio «antes» de la tienda.</p>
                </div>
            </div>
            <div class="flex items-start gap-4">
                <span class="text-accent text-2xl">📉</span>
                <div>
                    <h4 class="font-semibold text-white mb-1">Historial de Precios</h4>
                    <p class="text-gray-400 text-sm">Precio habitual, mínimo histórico y cada cambio de precio real, revisado dos veces al día.</p>
                </div>
            </div>
            <div class="flex items-start gap-4">
                <span class="text-accent text-2xl">🏪</span>
                <div>
                    <h4 class="font-semibold text-white mb-1">Comparativa entre Tiendas</h4>
                    <p class="text-gray-400 text-sm">El mismo producto en varias tiendas de España para ver dónde está el mejor precio ahora.</p>
                </div>
            </div>
            <div class="flex items-start gap-4">
                <span class="text-accent text-2xl">🛠️</span>
                <div>
                    <h4 class="font-semibold text-white mb-1">Panel de Administración</h4>
                    <p class="text-gray-400 text-sm">Productos, tiendas, importación de feeds, rastreador de precios, campañas y newsletter desde un panel propio.</p>
                </div>
            </div>
            <div class="flex items-start gap-4">
                <span class="text-accent text-2xl">🔗</span>
                <div>
                    <h4 class="font-semibold text-white mb-1">Afiliación Medida</h4>
                    <p class="text-gray-400 text-sm">Deeplinks automáticos de afiliado y cada clic a tienda registrado para saber qué ofertas generan tráfico.</p>
                </div>
            </div>
            <div class="flex items-start gap-4">
                <span class="text-accent text-2xl">📖</span>
                <div>
                    <h4 class="font-semibold text-white mb-1">Guías y Campañas</h4>
                    <p class="text-gray-400 text-sm">Guías de compra y landings de campaña como Black Friday para ayudar a decidir.</p>
                </div>
            </div>
        </div>
    </div>
</section>
